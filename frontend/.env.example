# Copier en frontend/.env.local si besoin.
#
# URL de base de l'API. Par défaut « /api » : en développement, le proxy Vite
# (vite.config.ts) redirige vers Flask sur http://127.0.0.1:5005.
# À définir uniquement si le frontend est servi séparément du backend.
# VITE_API_URL=https://mon-serveur.example.com/api

# Cible du proxy de développement (si Flask n'écoute pas sur 127.0.0.1:5005)
# VITE_PROXY_TARGET=http://127.0.0.1:5005
