# Copier ce fichier en backend/.env puis renseigner les valeurs.
# Toutes ces variables sont lues par backend/config/settings.py.

# ── Flask ──────────────────────────────────────────
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
PORT=5005
LOG_LEVEL=INFO
# Obligatoire en production (chaîne aléatoire longue)
SECRET_KEY=change_me_in_production

# ── MongoDB ────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=aviation_risk

# ── Pipeline ML ────────────────────────────────────
# Dossier contenant outputs/, baseline_models/ et uncertainty_outputs/
# (par défaut : notebooks/ à la racine du projet)
# ARTIFACTS_DIR=../notebooks
# Risque MAPIE : 0.10 → ensembles de prédiction à 90 % de couverture
MAPIE_ALPHA=0.10

# ── Google Gemini ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_S=30
# Modèle de secours si le principal est surchargé (vide pour désactiver)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ── CORS (origines autorisées, séparées par des virgules) ──
FRONTEND_URL=http://localhost:5173
